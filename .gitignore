# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# contract build output
/contract/node_modules
/contract/dist

# Compact prover/verifier keys — 7.7MB of binary, regenerate with `npm run compact`
/contract/src/managed/painpath/keys/

# clinician agent
/agent/node_modules
/agent/dist
/agent/logs
/agent/midnight-level-db
/agent/.midnight-level-db

# agent local passphrase for the encrypted private state store
/agent/.secrets
/agent/logs

# deployed contract address, environment-specific
/.midnight
